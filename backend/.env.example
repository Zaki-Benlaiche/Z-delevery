# انسخ هذا الملف إلى .env وعدّل القيم
APP_NAME=Z-delivry
DEBUG=true

# قاعدة البيانات (يجب أن تطابق docker-compose)
DATABASE_URL=postgresql+asyncpg://zdelivry:zdelivry_dev_pass@localhost:5432/zdelivry

# Redis
REDIS_URL=redis://localhost:6379/0

# الأمان — غيّر هذا المفتاح في الإنتاج!
SECRET_KEY=change-this-secret-key-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRE_SECONDS=300
OTP_DEV_MODE=true

# تسعير الطلبات (دج)
DELIVERY_BASE_FEE=200
DELIVERY_FEE_PER_KM=30
COMMISSION_RATE=0.10

# أرقام هواتف الأدمن (مفصولة بفاصلة) — تُرقَّى تلقائياً عند تسجيل الدخول
ADMIN_PHONES=
