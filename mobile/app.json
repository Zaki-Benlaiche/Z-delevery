{
  "expo": {
    "name": "Z-delivry",
    "slug": "z-delivry",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "zdelivry",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zdelivry.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لإظهار أقرب المتاجر وضبط عنوان التسليم."
      }
    },
    "android": {
      "package": "com.zdelivry.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_ANDROID_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "نحتاج موقعك لإظهار أقرب المتاجر."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول إلى صورك لرفع شعار المحلّ وصور المنتجات.",
          "cameraPermission": "نحتاج الكاميرا لالتقاط صور المنتجات."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://zdelivry-api.onrender.com",
      "cloudinary": {
        "cloudName": "dgebiyxv3",
        "uploadPreset": "ml_default"
      },
      "eas": {
        "projectId": "ebe4d59a-88dc-48ba-9a8d-91b110159f6b"
      }
    },
    "owner": "benlaiche_zakaria",
    "runtimeVersion": "0.1.0",
    "updates": {
      "url": "https://u.expo.dev/ebe4d59a-88dc-48ba-9a8d-91b110159f6b"
    }
  }
}
